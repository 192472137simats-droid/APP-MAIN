# --- LLM provider (OpenAI-compatible) -------------------------------------
# Default targets OpenRouter's free tier. Get a key: https://openrouter.ai/keys
LLM_API_KEY=your_key_here

# Any OpenAI-compatible base URL. Switch providers with just these three vars:
#   OpenRouter  https://openrouter.ai/api/v1     (default)
#   Groq        https://api.groq.com/openai/v1
#   Mistral     https://api.mistral.ai/v1
#   Cerebras    https://api.cerebras.ai/v1
LLM_BASE_URL=https://openrouter.ai/api/v1

# A model id the key can call. Free, large-context options on OpenRouter:
#   openai/gpt-oss-20b:free                  131k ctx, fast, reliable JSON
#   nvidia/nemotron-3-super-120b-a12b:free   262k ctx, higher quality
LLM_MODEL=openai/gpt-oss-20b:free

# Optional vision model for OCR of scanned PDFs (needs image input)
LLM_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

# --- Optional -------------------------------------------------------------
OPENALEX_MAILTO=you@example.com   # gets you into OpenAlex's faster "polite pool"
GROUNDING_CORPUS_SIZE=40
MAX_UPLOAD_MB=25
MAX_PAPER_CHARS=180000
DATA_DIR=./data
