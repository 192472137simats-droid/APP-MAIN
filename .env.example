# Required — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional
# Falls back automatically if this model is retired. GET /api/models shows
# what your key can actually call.
GEMINI_MODEL=gemini-3.6-flash
OPENALEX_MAILTO=you@example.com   # gets you into OpenAlex's faster "polite pool"
GROUNDING_CORPUS_SIZE=40
MAX_UPLOAD_MB=25
MAX_PAPER_CHARS=180000
DATA_DIR=./data
